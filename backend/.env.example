# Copy to backend/.env and fill in. backend/.env is git-ignored.
LIVE_ENABLED=1
LIVE_HOURS=24
GDELT_BACKFILL_HOURS=6

# aisstream.io (free): https://aisstream.io/apikeys
AISSTREAM_API_KEY=

# OpenSky Network: Account -> API client (client id + secret)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# or legacy basic auth:
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=
OPENSKY_INTERVAL=120
